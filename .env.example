# Copy to .env and fill in the real values. .env is git-ignored; never commit it.
# Nothing reads these yet: the settings loader arrives in step 6 of docs/PLAN.md.

# Local Postgres from compose.yaml. Throwaway credentials, localhost only.
DATABASE_URL=postgresql://firstseen:firstseen@localhost:5432/firstseen

# Telegram: the bot token from @BotFather and your own chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production database on Neon. Used only for deploys and migrations, never by tests.
PROD_DATABASE_URL=
PROD_DATABASE_URL_DIRECT=
